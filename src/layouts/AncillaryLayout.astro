---
import SiteFooter from "../components/SiteFooter.astro";
import InlinePageStyles from "../components/InlinePageStyles.astro";
import type { UiLanguage } from "../core/i18n";
import { getThemeSetting } from "../core/theme";
import alexandriaFontCssUrl from "../font-faces-alexandria.css?url";
import lineSeedJpFontCssUrl from "../font-faces-line-seed-jp.css?url";

interface Props {
  uiLanguage: UiLanguage;
  title: string;
  description: string;
  pathname: "/terms" | "/privacy" | "/languages";
}

const { uiLanguage, title, description, pathname } = Astro.props;
const themeSetting = getThemeSetting(Astro.cookies.get("ods_theme")?.value);
const productionOrigin =
  Astro.site ?? new URL("https://langrefsearch.com");
const localizedUrl = (language: UiLanguage) => {
  const url = new URL(pathname, productionOrigin);
  url.searchParams.set("ui", language);
  return url;
};
const canonicalUrl = localizedUrl(uiLanguage);
---

<html
  lang={uiLanguage}
  data-theme-setting={themeSetting}
  data-font-alexandria-url={alexandriaFontCssUrl}
  data-font-line-seed-jp-url={lineSeedJpFontCssUrl}
  data-needs-japanese-font={String(uiLanguage === "ja")}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="color-scheme"
      content={themeSetting === "system" ? "light dark" : `only ${themeSetting}`}
    />
    <meta
      name="theme-color"
      content="#825CFF"
      media={
        themeSetting === "system"
          ? "(prefers-color-scheme: light)"
          : themeSetting === "light"
            ? "all"
            : "not all"
      }
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#100D18"
      media={
        themeSetting === "system"
          ? "(prefers-color-scheme: dark)"
          : themeSetting === "dark"
            ? "all"
            : "not all"
      }
      data-theme-color="dark"
    />
    <meta name="application-name" content="LangRef Search" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={localizedUrl("en")} />
    <link rel="alternate" hreflang="ja" href={localizedUrl("ja")} />
    <link rel="preload" href={alexandriaFontCssUrl} as="style" fetchpriority="low" />
    {
      uiLanguage === "ja" && (
        <link rel="preload" href={lineSeedJpFontCssUrl} as="style" fetchpriority="low" />
      )
    }
    <noscript>
      <link rel="stylesheet" href={alexandriaFontCssUrl} />
      {uiLanguage === "ja" && <link rel="stylesheet" href={lineSeedJpFontCssUrl} />}
    </noscript>
    <InlinePageStyles />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body>
    <div class="legal-shell">
      <header class="legal-header">
        <a
          class="legal-home-link"
          href={`/?ui=${uiLanguage}`}
          aria-label={uiLanguage === "ja" ? "LangRef Searchのトップへ" : "LangRef Search home"}
        >
          <span class="site-logo">
            <img
              class="site-logo-mark"
              src="/icon.png"
              width="192"
              height="192"
              alt=""
              decoding="async"
            />
            <img
              class="site-logo-wordmark"
              src="/logo_svg.svg"
              width="1788"
              height="210"
              alt="LangRef Search"
              decoding="async"
            />
          </span>
        </a>
        <nav
          class="legal-language-nav"
          aria-label={uiLanguage === "ja" ? "表示言語" : "Display language"}
        >
          <a
            href={`${pathname}?ui=en`}
            lang="en"
            aria-current={uiLanguage === "en" ? "page" : undefined}
          >EN</a>
          <span aria-hidden="true">/</span>
          <a
            href={`${pathname}?ui=ja`}
            lang="ja"
            aria-current={uiLanguage === "ja" ? "page" : undefined}
          >JA</a>
        </nav>
      </header>
      <main class="legal-content">
        <slot />
      </main>
      <SiteFooter uiLanguage={uiLanguage} />
    </div>
    <script is:inline>
      for (const family of [
        "alexandria",
        ...(document.documentElement.lang === "ja" ? ["line-seed-jp"] : [])
      ]) {
        const key = family === "alexandria"
          ? "fontAlexandriaUrl"
          : "fontLineSeedJpUrl";
        const href = document.documentElement.dataset[key];
        if (!href) continue;
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = href;
        link.dataset.loadedFontStylesheet = family;
        document.head.append(link);
      }
    </script>
  </body>
</html>
