---
import {
  getDocumentKindLabel,
  getPreferredUiLanguage,
  getSourceKindLabel,
  getUiLanguage,
  t
} from "../core/i18n";
import { parseQuery } from "../core/query";
import type { SourceMode } from "../core/query";
import {
  isSourcePolicy,
  mergeNewLanguageSourceDefaults,
  resolveDocumentationLocale,
  resolveSourceOptionState,
  sourcePolicyFromLegacyPreferences
} from "../core/search-controls";
import { getKnownLanguageIds, loadCatalog, resolveSearchScope } from "../core/sources";
import {
  getLanguageColor,
  getLanguageTagTextColor
} from "../core/language-colors";
import { getThemeSetting } from "../core/theme";
import {
  SEARCH_RUNTIME_MANIFEST_PATH,
  selectInitialSearchPreloads
} from "../core/search-preloads";
import SiteFooter from "../components/SiteFooter.astro";
import InlinePageStyles from "../components/InlinePageStyles.astro";
import alexandriaFontCssUrl from "../font-faces-alexandria.css?url";
import lineSeedJpFontCssUrl from "../font-faces-line-seed-jp.css?url";
import runtimeSearchManifest from "../../public/search-index/runtime-manifest.json";

export const prerender = false;

const catalog = loadCatalog();
const params = Astro.url.searchParams;
const q = params.get("q") ?? "";
const languagePreference = (value: string | null | undefined) =>
  value === "en" || value === "ja" ? value : undefined;
const requestedUiLanguage = languagePreference(params.get("ui"));
const legacyUrlLanguage = languagePreference(params.get("docsLocale"));
const storedUiLanguage = languagePreference(Astro.cookies.get("ods_ui")?.value);
const legacyStoredLanguage = languagePreference(
  Astro.cookies.get("ods_docs_locale")?.value
);
const preferredRequestLanguage = getPreferredUiLanguage(
  Astro.request.headers.get("accept-language")
);
const themeSetting = getThemeSetting(Astro.cookies.get("ods_theme")?.value);
const uiLanguage = getUiLanguage(
  requestedUiLanguage ??
    legacyUrlLanguage ??
    storedUiLanguage ??
    legacyStoredLanguage ??
    preferredRequestLanguage
);
Astro.response.headers.append("Vary", "Accept-Language, Cookie");
if (
  !requestedUiLanguage &&
  !legacyUrlLanguage &&
  !storedUiLanguage &&
  legacyStoredLanguage
) {
  Astro.cookies.set("ods_ui", uiLanguage, {
    path: "/",
    maxAge: 31_536_000,
    sameSite: "lax"
  });
}
if (Astro.cookies.has("ods_docs_locale")) {
  Astro.cookies.delete("ods_docs_locale", { path: "/" });
}
const cookieSourcePolicy = Astro.cookies.get("ods_source_policy")?.value;
const cookieSourceMode = Astro.cookies.get("ods_source")?.value;
const cookieAutoNonOfficial = Astro.cookies.get("ods_auto_non_official")?.value;
const formSourcePolicy = params.get("sourcePolicy");
const selectedSourcePolicy = isSourcePolicy(formSourcePolicy)
  ? formSourcePolicy
  : isSourcePolicy(cookieSourcePolicy)
    ? cookieSourcePolicy
    : sourcePolicyFromLegacyPreferences(cookieSourceMode, cookieAutoNonOfficial);
if (isSourcePolicy(formSourcePolicy)) {
  Astro.cookies.set("ods_source_policy", formSourcePolicy, {
    path: "/",
    maxAge: 31_536_000,
    sameSite: "lax"
  });
}
const selectedSourceIds = new Set(params.getAll("sourceId"));
const hasExplicitSourceSelection = params.get("sourceSelection") === "explicit";
const submittedSourceLanguageIds = new Set(params.getAll("sourceScopeLanguage"));

const knownLanguages = getKnownLanguageIds(catalog);
const parsed = parseQuery(q, {
  knownLanguages
});
const effectiveSourcePolicy =
  parsed.sourceMode === "all"
    ? "all"
    : parsed.sourceMode === "official"
      ? "official"
      : selectedSourcePolicy;
const sourceMode: SourceMode =
  effectiveSourcePolicy === "all" ? "all" : "official";
const autoIncludeNonOfficialWhenNoOfficial =
  effectiveSourcePolicy === "fallback";
const locale = resolveDocumentationLocale(parsed.locale, uiLanguage);
const requestedLanguageScope = resolveSearchScope(catalog, {
  languages: parsed.languages,
  sourceMode: "all"
}).languages;
const submittedSelectedIds =
  selectedSourceIds.size > 0 || hasExplicitSourceSelection
    ? selectedSourceIds
    : new Set(
        catalog.languages
          .flatMap((language) => language.sources)
          .filter((source) => source.defaultEnabled)
          .map((source) => source.id)
      );
const selectedIds = hasExplicitSourceSelection
  ? mergeNewLanguageSourceDefaults(
      submittedSelectedIds,
      submittedSourceLanguageIds,
      requestedLanguageScope
    )
  : submittedSelectedIds;

const scope = resolveSearchScope(catalog, {
  languages: parsed.languages,
  locale,
  sourceMode,
  enabledSourceIds: selectedIds,
  autoIncludeNonOfficialWhenNoOfficial
});
const trustedScope = resolveSearchScope(catalog, {
  languages: parsed.languages,
  locale,
  sourceMode: "all"
});

const hasQuery = q.trim().length > 0;
const visibleSourceLanguages =
  hasQuery && parsed.languages.length > 0 ? trustedScope.languages : catalog.languages;
const visibleSourceLanguageIds = new Set(
  visibleSourceLanguages.map((language) => language.id)
);
const sourceLanguages = [
  ...visibleSourceLanguages,
  ...catalog.languages.filter(
    (language) => !visibleSourceLanguageIds.has(language.id)
  )
];
const initialSourceOptionState = resolveSourceOptionState(
  sourceLanguages.flatMap((language) =>
    language.sources.map((source) => ({
      id: source.id,
      kind: source.kind,
      checked: selectedIds.has(source.id),
      automaticFallbackAllowed: language.autoNonOfficialFallback
    }))
  ),
  effectiveSourcePolicy
);
const sourceOptionStateById = new Map(
  initialSourceOptionState.options.map((option) => [option.id, option])
);
const preservedDisabledSourceIds = initialSourceOptionState.preservedIds;
const proposalSources = sourceLanguages.flatMap((language) =>
  language.sources.filter((source) => source.documentKind === "proposal")
);
const enabledProposalSources = proposalSources.filter(
  (source) => sourceOptionStateById.get(source.id)?.disabled !== true
);
const proposalSourceToggleChecked =
  enabledProposalSources.length > 0 &&
  enabledProposalSources.every(
    (source) => sourceOptionStateById.get(source.id)?.checked === true
  );
const searchSyntaxRows = [
  {
    syntax: "<language> <search words>",
    example: "js promise all"
  },
  {
    syntax: "lang:<language> <search words>",
    example: "lang:rust iterator"
  },
  {
    syntax: "<language>, <language> <search words>",
    example: "rust, ts generic"
  },
  {
    syntax: "lang:<language>,<language> <search words>",
    example: "lang:python,rust iterator"
  },
  {
    syntax: "<search words> locale:ja",
    example: "iterator locale:ja"
  },
  {
    syntax: "<search words> source:all",
    example: "proxy source:all"
  }
];
const suggestionScopes = catalog.languages.map((language) => ({
  id: language.id,
  aliases: [...language.aliases, ...language.bareAliases],
  autoNonOfficialFallback: language.autoNonOfficialFallback,
  sources: language.sources
    .filter((source) => selectedIds.has(source.id))
    .map((source) => ({
      id: source.id,
      name: source.name,
      kind: source.kind
    }))
}));
const clientSearchCatalog = catalog.languages.map((language) => ({
  id: language.id,
  name: language.name,
  aliases: [...language.aliases, ...language.bareAliases],
  autoNonOfficialFallback: language.autoNonOfficialFallback,
  sources: language.sources.map((source) => ({
    id: source.id,
    name: source.name,
    kind: source.kind,
    defaultEnabled: source.defaultEnabled,
    selected: selectedIds.has(source.id)
  }))
}));
const productionOrigin =
  Astro.site ?? new URL("https://langrefsearch.com");
const rootUrl = new URL("/", productionOrigin);
const localizedHomeUrl = (language: "en" | "ja") => {
  const url = new URL("/", productionOrigin);
  url.searchParams.set("ui", language);
  return url;
};
const englishHomeUrl = localizedHomeUrl("en");
const japaneseHomeUrl = localizedHomeUrl("ja");
const hasNonLocaleParameters = [...params.keys()].some((key) => key !== "ui");
const canonicalUrl =
  requestedUiLanguage || hasNonLocaleParameters
    ? localizedHomeUrl(uiLanguage)
    : rootUrl;
const robotsContent = hasNonLocaleParameters
  ? "noindex,follow"
  : "index,follow,max-image-preview:large";
const socialImageUrl = new URL("/ogp.png", productionOrigin);
const openGraphLocale = uiLanguage === "ja" ? "ja_JP" : "en_US";
const alternateOpenGraphLocale = uiLanguage === "ja" ? "en_US" : "ja_JP";
const needsJapaneseFont = uiLanguage === "ja" || locale === "ja";
const shouldPreloadSearch =
  hasQuery && parsed.errors.length === 0 && scope.sources.length > 0;
const initialSearchPreloads = shouldPreloadSearch
  ? selectInitialSearchPreloads(runtimeSearchManifest, scope.sources, locale ?? "")
  : [];
---

<html
  lang={uiLanguage}
  data-theme-setting={themeSetting}
  data-font-alexandria-url={alexandriaFontCssUrl}
  data-font-line-seed-jp-url={lineSeedJpFontCssUrl}
  data-needs-japanese-font={String(needsJapaneseFont)}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="color-scheme"
      content={themeSetting === "system" ? "light dark" : `only ${themeSetting}`}
    />
    <meta
      name="theme-color"
      content="#825CFF"
      media={
        themeSetting === "system"
          ? "(prefers-color-scheme: light)"
          : themeSetting === "light"
            ? "all"
            : "not all"
      }
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#100D18"
      media={
        themeSetting === "system"
          ? "(prefers-color-scheme: dark)"
          : themeSetting === "dark"
            ? "all"
            : "not all"
      }
      data-theme-color="dark"
    />
    <meta name="application-name" content={t(uiLanguage, "siteName")} />
    <meta name="description" content={t(uiLanguage, "description")} />
    <meta name="robots" content={robotsContent} />
    <title>{t(uiLanguage, "title")}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishHomeUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseHomeUrl} />
    <link rel="alternate" hreflang="x-default" href={rootUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(uiLanguage, "siteName")} />
    <meta property="og:title" content={t(uiLanguage, "title")} />
    <meta property="og:description" content={t(uiLanguage, "description")} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:locale:alternate" content={alternateOpenGraphLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={t(uiLanguage, "socialImageAlt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t(uiLanguage, "title")} />
    <meta name="twitter:description" content={t(uiLanguage, "description")} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={t(uiLanguage, "socialImageAlt")} />
    <link rel="preload" href="/icon.png" as="image" type="image/png" fetchpriority="high" />
    <link rel="preload" href="/logo_svg.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="preload" href={alexandriaFontCssUrl} as="style" fetchpriority="low" />
    {
      needsJapaneseFont && (
        <link rel="preload" href={lineSeedJpFontCssUrl} as="style" fetchpriority="low" />
      )
    }
    <noscript>
      <link rel="stylesheet" href={alexandriaFontCssUrl} />
      {needsJapaneseFont && <link rel="stylesheet" href={lineSeedJpFontCssUrl} />}
    </noscript>
    <InlinePageStyles />
    {
      shouldPreloadSearch && (
        <link
          rel="preload"
          href={SEARCH_RUNTIME_MANIFEST_PATH}
          as="fetch"
          type="application/json"
          crossorigin="anonymous"
          fetchpriority="high"
        />
      )
    }
    {
      initialSearchPreloads.map((path) => (
        <link
          rel="preload"
          href={path}
          as="fetch"
          type="application/json"
          crossorigin="anonymous"
          fetchpriority="high"
        />
      ))
    }
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "LangRef Search",
        "url": "https://langrefsearch.com/",
        "inLanguage": ["en", "ja"]
      }
    </script>
  </head>
  <body>


    <main class="page" data-search-page>
      <section class="search-panel" aria-labelledby="search-heading">
        <div class="search-header">
          <h1 id="search-heading" tabindex="-1" data-page-top-target>
            <span class="site-logo">
              <img
                class="site-logo-mark"
                src="/icon.png"
                width="192"
                height="192"
                alt=""
                decoding="async"
                fetchpriority="high"
              />
              <img
                class="site-logo-wordmark"
                src="/logo_svg.svg"
                width="1788"
                height="210"
                alt={t(uiLanguage, "queryLabel")}
                decoding="async"
                fetchpriority="high"
              />
            </span>
          </h1>
          <div class="header-actions">
            <div class="theme-menu-shell" data-theme-menu-shell>
              <button
                class="theme-menu-button"
                id="theme-menu-button"
                type="button"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="theme-menu"
                data-theme-menu-button
                data-localized-aria-label
                data-label-en={t("en", "theme")}
                data-label-ja={t("ja", "theme")}
                aria-label={t(uiLanguage, "theme")}
              >
                <svg
                  class="theme-icon theme-icon-dark"
                  data-theme-icon="dark"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M20.2 15.3A8.6 8.6 0 0 1 8.7 3.8 8.6 8.6 0 1 0 20.2 15.3Z"></path>
                </svg>
                <svg
                  class="theme-icon theme-icon-light"
                  data-theme-icon="light"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="12" cy="12" r="3.5"></circle>
                  <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                </svg>
                <svg
                  class="theme-icon theme-icon-system"
                  data-theme-icon="system"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="3" y="4" width="18" height="13" rx="2"></rect>
                  <path d="M8 21h8M12 17v4"></path>
                </svg>
              </button>
              <div
                class="theme-menu"
                id="theme-menu"
                role="menu"
                aria-labelledby="theme-menu-button"
                data-theme-menu
                hidden
              >
                {
                  (["dark", "light", "system"] as const).map((setting) => {
                    const labelKey = {
                      dark: "themeDark",
                      light: "themeLight",
                      system: "themeSystem"
                    }[setting];
                    return (
                      <button
                        class="theme-menu-option"
                        type="button"
                        role="menuitemradio"
                        aria-checked={String(themeSetting === setting)}
                        tabindex="-1"
                        data-theme-option={setting}
                      >
                        {
                          setting === "dark" && (
                            <svg
                              class="theme-option-icon"
                              data-theme-option-icon="dark"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              focusable="false"
                            >
                              <path d="M20.2 15.3A8.6 8.6 0 0 1 8.7 3.8 8.6 8.6 0 1 0 20.2 15.3Z"></path>
                            </svg>
                          )
                        }
                        {
                          setting === "light" && (
                            <svg
                              class="theme-option-icon"
                              data-theme-option-icon="light"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              focusable="false"
                            >
                              <circle cx="12" cy="12" r="3.5"></circle>
                              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                            </svg>
                          )
                        }
                        {
                          setting === "system" && (
                            <svg
                              class="theme-option-icon"
                              data-theme-option-icon="system"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              focusable="false"
                            >
                              <rect x="3" y="4" width="18" height="13" rx="2"></rect>
                              <path d="M8 21h8M12 17v4"></path>
                            </svg>
                          )
                        }
                        <span class="lang-en">{t("en", labelKey)}</span>
                        <span class="lang-ja">{t("ja", labelKey)}</span>
                        <svg
                          class="theme-option-check"
                          viewBox="0 0 16 16"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="m3 8 3 3 7-7"></path>
                        </svg>
                      </button>
                    );
                  })
                }
              </div>
            </div>
            <fieldset class="lang-switch" data-language-switch>
              <legend class="sr-only">
                <span class="lang-en">{t("en", "uiLanguage")}</span>
                <span class="lang-ja">{t("ja", "uiLanguage")}</span>
              </legend>
              <label class:list={["lang-btn", { active: uiLanguage === "en" }]}>
                <input type="radio" name="ui" value="en" class="sr-only" checked={uiLanguage === "en"} data-ui-radio>
                EN
              </label>
              <label class:list={["lang-btn", { active: uiLanguage === "ja" }]}>
                <input type="radio" name="ui" value="ja" class="sr-only" checked={uiLanguage === "ja"} data-ui-radio>
                JA
              </label>
            </fieldset>
          </div>
        </div>
        <form
          class="search-form"
          method="get"
          action="/"
          data-search-form
          data-docs-locale={locale ?? ""}
          data-query-locale={parsed.locale ?? ""}
        >
          <input type="hidden" name="ui" value={uiLanguage} data-ui-hidden />
          <input type="hidden" name="sourceSelection" value="explicit" />
          {
            visibleSourceLanguages.map((language) => (
              <input
                type="hidden"
                name="sourceScopeLanguage"
                value={language.id}
              />
            ))
          }
          {
            preservedDisabledSourceIds.map((sourceId) => (
              <input
                type="hidden"
                name="sourceId"
                value={sourceId}
                data-preserved-source
              />
            ))
          }
          <div class="query-row" data-page-top-sentinel>
            <div class="search-group">
              <label class="sr-only" for="q">
                <span class="lang-en">{t("en", "queryInputLabel")}</span>
                <span class="lang-ja">{t("ja", "queryInputLabel")}</span>
              </label>
              <div
                class="query-stack"
                data-query-stack
                data-known-languages={JSON.stringify(Array.from(knownLanguages))}
                data-suggestion-scopes={JSON.stringify(suggestionScopes)}
                data-client-search-catalog={JSON.stringify(clientSearchCatalog)}
              >
                <div class="query-highlight" aria-hidden="true" data-query-highlight></div>
                <input
                  id="q"
                  name="q"
                  value={q}
                  autocomplete="off"
                  spellcheck="false"
                  enterkeyhint="enter"
                  aria-describedby="query-example"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="search-suggestions"
                  data-query-input
                  autofocus
                />
                <button
                  class="query-clear"
                  type="button"
                  data-query-clear
                  data-localized-aria-label
                  data-label-en={t("en", "clearQuery")}
                  data-label-ja={t("ja", "clearQuery")}
                  aria-label={t(uiLanguage, "clearQuery")}
                  hidden={q.length === 0}
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M6 6 18 18M18 6 6 18"></path>
                  </svg>
                </button>
                <div
                  id="search-suggestions"
                  class="search-suggestions"
                  role="listbox"
                  data-search-suggestions
                  hidden
                ></div>
              </div>
              <button class="search-submit" type="submit">
                <span class="lang-en">{t("en", "search")}</span>
                <span class="lang-ja">{t("ja", "search")}</span>
              </button>
              <button
                class="search-help-button"
                type="button"
                data-help-open
                aria-labelledby="search-help-label"
                aria-haspopup="dialog"
                aria-controls="search-help-dialog"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M9.8 9.1a2.4 2.4 0 0 1 4.65.85c0 1.8-2.45 2.05-2.45 3.65"></path>
                  <circle class="search-help-dot" cx="12" cy="17.2" r=".75"></circle>
                </svg>
                <span class="sr-only" id="search-help-label">
                  <span class="lang-en">{t("en", "help")}</span>
                  <span class="lang-ja">{t("ja", "help")}</span>
                </span>
                <span class="search-help-tooltip" aria-hidden="true">
                  <span class="lang-en">{t("en", "help")}</span>
                  <span class="lang-ja">{t("ja", "help")}</span>
                </span>
              </button>
            </div>
          </div>

          <div
            class="active-tags"
            role="group"
            data-active-tags
            data-localized-aria-label
            data-label-en={t("en", "activeTags")}
            data-label-ja={t("ja", "activeTags")}
            aria-label={t(uiLanguage, "activeTags")}
            hidden={parsed.languages.length === 0}
          >
            {parsed.languages.map((lang) => {
                  const langName = catalog.languages.find((l) => l.id === lang)?.name || lang;
                  const languageColor = getLanguageColor(lang);
                  const languageTextColor = languageColor
                    ? getLanguageTagTextColor(languageColor)
                    : undefined;
                  return (
                    <span
                      class="fpill language-fpill"
                      style={
                        languageColor && languageTextColor
                          ? `--language-color: ${languageColor}; --language-text-color: ${languageTextColor};`
                          : undefined
                      }
                    >
                      <span class="fpill-label">{langName}</span>
                      <button type="button" class="fpill-x" data-remove-tag={lang}>
                        <span aria-hidden="true">×</span>
                        <span class="sr-only">
                          <span class="lang-en">
                            {t("en", "removeLanguage").replace("{language}", langName)}
                          </span>
                          <span class="lang-ja">
                            {t("ja", "removeLanguage").replace("{language}", langName)}
                          </span>
                        </span>
                      </button>
                    </span>
                  );
                })}
          </div>

          <p class="examples" id="query-example">
            <span class="lang-en">{t("en", "examples")}</span>
            <span class="lang-ja">{t("ja", "examples")}</span>
          </p>

          <div class="controls-row">
            <div class="filters setting-row source-policy-setting">
              <span class="filter-label" id="source-policy-label">
                <span class="lang-en">{t("en", "sourcePolicyLabel")}</span>
                <span class="lang-ja">{t("ja", "sourcePolicyLabel")}</span>
              </span>
              <fieldset class="seg-toggle source-policy-toggle" aria-labelledby="source-policy-label">
                <legend class="sr-only">
                  <span class="lang-en">{t("en", "sourcePolicyLabel")}</span>
                  <span class="lang-ja">{t("ja", "sourcePolicyLabel")}</span>
                </legend>
                <label class:list={["seg-btn", { active: effectiveSourcePolicy === "official" }]}>
                  <input
                    type="radio"
                    name="sourcePolicy"
                    value="official"
                    class="sr-only"
                    checked={effectiveSourcePolicy === "official"}
                    data-source-policy-radio
                  />
                  <span class="lang-en">{t("en", "sourcePolicyOfficial")}</span>
                  <span class="lang-ja">{t("ja", "sourcePolicyOfficial")}</span>
                </label>
                <label class:list={["seg-btn", { active: effectiveSourcePolicy === "fallback" }]}>
                  <input
                    type="radio"
                    name="sourcePolicy"
                    value="fallback"
                    class="sr-only"
                    checked={effectiveSourcePolicy === "fallback"}
                    data-source-policy-radio
                  />
                  <span class="lang-en">{t("en", "sourcePolicyFallback")}</span>
                  <span class="lang-ja">{t("ja", "sourcePolicyFallback")}</span>
                </label>
                <label class:list={["seg-btn", { active: effectiveSourcePolicy === "all" }]}>
                  <input
                    type="radio"
                    name="sourcePolicy"
                    value="all"
                    class="sr-only"
                    checked={effectiveSourcePolicy === "all"}
                    data-source-policy-radio
                  />
                  <span class="lang-en">{t("en", "sourcePolicyAll")}</span>
                  <span class="lang-ja">{t("ja", "sourcePolicyAll")}</span>
                </label>
              </fieldset>
            </div>

          </div>

          <details class="source-details">
            <summary>
              <span class="lang-en">{t("en", "sources")}</span>
              <span class="lang-ja">{t("ja", "sources")}</span>
            </summary>
            {
              proposalSources.length > 0 && (
                <div class="source-group-controls">
                  <label class="source-group-option">
                    <input
                      type="checkbox"
                      checked={proposalSourceToggleChecked}
                      disabled={enabledProposalSources.length === 0}
                      class="pill-toggle"
                      data-proposal-source-toggle
                    />
                    <span>
                      <span class="lang-en">{t("en", "includeProposalSources")}</span>
                      <span class="lang-ja">{t("ja", "includeProposalSources")}</span>
                    </span>
                  </label>
                </div>
              )
            }
            <div class="source-lists">
              {
                sourceLanguages.map((language) => (
                  <div
                    class="language-group"
                    data-source-language-group={language.id}
                    hidden={!visibleSourceLanguageIds.has(language.id)}
                  >
                    <h3 class="language-name">{language.name}</h3>
                    <div class="source-grid">
                      {
                        language.sources.map((source) => {
                          const state = sourceOptionStateById.get(source.id);
                          const disabled = state?.disabled ?? false;
                          return (
                            <div class:list={["source-option", { disabled }]}>
                              <input
                                id={`source-${source.id}`}
                                type="checkbox"
                                name="sourceId"
                                value={source.id}
                                checked={state?.checked ?? false}
                                disabled={disabled}
                                class="pill-toggle"
                                data-source-option
                                data-source-kind={source.kind}
                                data-document-kind={source.documentKind}
                                data-auto-fallback-allowed={String(language.autoNonOfficialFallback)}
                                data-supports-ja={String(source.siteLocales.includes("ja"))}
                              />
                              <div class="source-copy">
                                <label class="source-title" for={`source-${source.id}`}>
                                  <strong>{source.name}</strong>
                                </label>
                                <div class="source-meta">
                                  <span class="source-kind">
                                    <span class="lang-en">{getSourceKindLabel("en", source.kind)}</span>
                                    <span class="lang-ja">{getSourceKindLabel("ja", source.kind)}</span>
                                  </span>
                                  {source.documentKind !== "reference" && (
                                    <span class="source-kind">
                                      <span class="lang-en">
                                        {getDocumentKindLabel("en", source.documentKind)}
                                      </span>
                                      <span class="lang-ja">
                                        {getDocumentKindLabel("ja", source.documentKind)}
                                      </span>
                                    </span>
                                  )}
                                  <a
                                    class="source-link"
                                    href={source.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${source.name}: ${source.domains[0]}`}
                                  >
                                    <span>{source.domains[0]}</span>
                                    <svg
                                      class="external-link-mark"
                                      viewBox="0 0 16 16"
                                      aria-hidden="true"
                                      focusable="false"
                                    >
                                      <path d="M6 4h6v6M12 4 4 12" />
                                    </svg>
                                  </a>
                                  {
                                    !source.siteLocales.includes("ja") && (
                                      <span class="source-ja-unavailable">
                                        <span class="lang-en">{t("en", "japaneseUnavailable")}</span>
                                        <span class="lang-ja">{t("ja", "japaneseUnavailable")}</span>
                                      </span>
                                    )
                                  }
                                </div>
                                {
                                  source.qualification && (
                                    <small class="source-qualification">
                                      <span class="lang-en">
                                        {t("en", "qualificationLabel")} {source.qualification.en}
                                      </span>
                                      <span class="lang-ja">
                                        {t("ja", "qualificationLabel")}{source.qualification.ja}
                                      </span>
                                    </small>
                                  )
                                }
                              </div>
                            </div>
                          );
                        })
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </details>
        </form>
      </section>

      <section
        class="notice error"
        aria-live="polite"
        data-query-errors
        hidden={parsed.errors.length === 0}
      >
        {parsed.errors.map((error) => <p>{error.message}</p>)}
      </section>

      <section
        class="results"
        data-localized-aria-label
        data-label-en={t("en", "resultsTitle")}
        data-label-ja={t("ja", "resultsTitle")}
        aria-label={t(uiLanguage, "resultsTitle")}
        hidden={!hasQuery || parsed.errors.length > 0}
      >
                <div
                  data-search-results
                  data-loading="true"
                  aria-busy="true"
                  data-query={parsed.searchText}
                  data-docs-locale={locale ?? ""}
                  data-no-sources={String(scope.sources.length === 0)}
                  data-sources={JSON.stringify(scope.sources.map((source) => ({
                    id: source.id,
                    name: source.name,
                    programmingLanguage: source.language,
                    programmingLanguageName:
                      catalog.languages.find((language) => language.id === source.language)?.name ??
                      source.language,
                    programmingLanguageColor:
                      getLanguageColor(source.language)
                  })))}
                >
                  <div
                    class="index-coverage"
                    data-index-coverage
                    data-unsupported-en={t("en", "indexUnavailable")}
                    data-unsupported-ja={t("ja", "indexUnavailable")}
                    data-planned-en={t("en", "indexPlanned")}
                    data-planned-ja={t("ja", "indexPlanned")}
                    data-blocked-en={t("en", "indexBlocked")}
                    data-blocked-ja={t("ja", "indexBlocked")}
                    data-disabled-en={t("en", "indexDisabled")}
                    data-disabled-ja={t("ja", "indexDisabled")}
                    data-locale-fallback-summary-en={t("en", "localeFallbackSummary")}
                    data-locale-fallback-summary-ja={t("ja", "localeFallbackSummary")}
                    data-index-load-failed-en={t("en", "indexLoadFailed")}
                    data-index-load-failed-ja={t("ja", "indexLoadFailed")}
                    hidden
                  ></div>
                  <p
                    class="search-status sr-only"
                    data-search-status
                    data-state="loading"
                    role="status"
                    data-loading-en={t("en", "searchLoading")}
                    data-loading-ja={t("ja", "searchLoading")}
                    data-success-en={t("en", "resultCount")}
                    data-success-ja={t("ja", "resultCount")}
                    data-empty-en={t("en", "noResults")}
                    data-empty-ja={t("ja", "noResults")}
                    data-no-sources-en={t("en", "noSources")}
                    data-no-sources-ja={t("ja", "noSources")}
                    data-error-en={t("en", "searchProviderError")}
                    data-error-ja={t("ja", "searchProviderError")}
                  >
                    <span class="lang-en">{t("en", "searchLoading")}</span>
                    <span class="lang-ja">{t("ja", "searchLoading")}</span>
                  </p>
                  <div class="result-loading" data-result-loading aria-hidden="true">
                    <ol class="result-skeleton-list">
                      {
                        Array.from({ length: 4 }, (_, index) => (
                          <li class="result-skeleton-card" data-skeleton-index={index}>
                            <span class="result-skeleton-heading">
                              <span class="result-skeleton-line result-skeleton-title"></span>
                              <span class="result-skeleton-line result-skeleton-tags"></span>
                            </span>
                            <span class="result-skeleton-line result-skeleton-source"></span>
                            <span class="result-skeleton-line result-skeleton-detail"></span>
                          </li>
                        ))
                      }
                    </ol>
                    <span class="result-loading-indicator">
                      <span class="result-loading-spinner"></span>
                    </span>
                  </div>
                  <div data-result-filters hidden></div>
                  <div data-result-source-notes hidden></div>
                  <ol class="result-list" data-result-list></ol>
                  <div data-result-pagination></div>
                </div>
      </section>
    </main>

    <SiteFooter uiLanguage={uiLanguage} />

    <button
      type="button"
      class="back-to-top"
      data-back-to-top
      data-label-en={t("en", "pageTop")}
      data-label-ja={t("ja", "pageTop")}
      aria-label={t(uiLanguage, "pageTop")}
      hidden
    >
      <span aria-hidden="true">↑</span>
    </button>

    <dialog
      class="help-dialog"
      id="search-help-dialog"
      aria-labelledby="search-help-dialog-title"
      data-help-dialog
    >
      <form method="dialog">
        <div class="dialog-header">
          <h2 id="search-help-dialog-title">
            <span class="lang-en">{t("en", "help")}</span>
            <span class="lang-ja">{t("ja", "help")}</span>
          </h2>
          <button
            class="icon-button"
            value="close"
            data-localized-aria-label
            data-label-en={t("en", "close")}
            data-label-ja={t("ja", "close")}
            aria-label={t(uiLanguage, "close")}
          >×</button>
        </div>
        <div class="help-content">
          {
            searchSyntaxRows.map((row) => (
              <div class="help-rule">
                <p class="help-syntax"><code>{row.syntax}</code></p>
                <small class="help-example">
                  <span class="lang-en">Example: {row.example}</span>
                  <span class="lang-ja">例：{row.example}</span>
                </small>
              </div>
            ))
          }
          <p class="help-note">
            <span class="lang-en">{t("en", "multiTermAnd")}</span>
            <span class="lang-ja">{t("ja", "multiTermAnd")}</span>
          </p>
          <p class="help-note">
            <span class="lang-en">{t("en", "shortAliases")}</span>
            <span class="lang-ja">{t("ja", "shortAliases")}</span>
          </p>
          <p class="help-note">
            <span class="lang-en">{t("en", "flagsRule")}</span>
            <span class="lang-ja">{t("ja", "flagsRule")}</span>
          </p>
          <p class="help-note">
            <span class="lang-en">{t("en", "symbolsHelp")}</span>
            <span class="lang-ja">{t("ja", "symbolsHelp")}</span>
          </p>
        </div>
      </form>
    </dialog>
    <script>
      import { initializeClientSearchPage } from "../client/search-page";

      const page = document.querySelector<HTMLElement>("[data-search-page]");
      if (page && page.dataset.clientInitialized !== "true") {
        page.dataset.clientInitialized = "true";
        void initializeClientSearchPage();
      }
    </script>
  </body>
</html>
