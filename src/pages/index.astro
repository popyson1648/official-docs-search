---
import { getUiLanguage, t } from "../core/i18n";
import { buildProgrammableSearchConfig } from "../core/pse";
import { parseQuery } from "../core/query";
import type { SourceMode } from "../core/query";
import { getKnownLanguageIds, loadCatalog, resolveSearchScope, sourceLabel } from "../core/sources";

export const prerender = false;

const catalog = loadCatalog();
const params = Astro.url.searchParams;
const q = params.get("q") ?? "";
const uiLanguage = getUiLanguage(params.get("ui") ?? Astro.cookies.get("ods_ui")?.value);
const cookieSourceMode = Astro.cookies.get("ods_source")?.value;
const formSourceMode = params.get("sourceMode");
const defaultSourceMode: SourceMode =
  formSourceMode === "all" || cookieSourceMode === "all" ? "all" : "official";
const docsLocale = params.get("docsLocale") || Astro.cookies.get("ods_docs_locale")?.value || undefined;
const selectedSourceIds = new Set(params.getAll("sourceId"));

const knownLanguages = getKnownLanguageIds(catalog);
const parsed = parseQuery(q, {
  knownLanguages
});
const sourceMode = parsed.sourceMode ?? defaultSourceMode;
const locale = parsed.locale ?? docsLocale;
const selectedIds =
  selectedSourceIds.size > 0
    ? selectedSourceIds
    : new Set(
        catalog.languages
          .flatMap((language) => language.sources)
          .filter((source) => source.defaultEnabled)
          .map((source) => source.id)
      );

const scope = resolveSearchScope(catalog, {
  languages: parsed.languages,
  locale,
  sourceMode,
  enabledSourceIds: selectedIds
});
const trustedScope = resolveSearchScope(catalog, {
  languages: parsed.languages,
  locale,
  sourceMode: "all"
});

const hasQuery = q.trim().length > 0;
const shouldSearch = hasQuery && parsed.errors.length === 0 && scope.sources.length > 0;
const pseConfig = shouldSearch ? buildProgrammableSearchConfig(parsed.searchText, scope.sources) : undefined;
const googleCx = import.meta.env.PUBLIC_GOOGLE_PROGRAMMABLE_SEARCH_CX ?? "";

const clientSources = catalog.languages.flatMap((lang) =>
  (lang.sources ?? []).map((source) => ({
    id: source.id,
    language: lang.id,
    languageName: lang.name,
    domains: source.domains ?? [],
    pathPrefixes: source.path_prefixes ?? source.pathPrefixes ?? []
  }))
);
---

<html lang={uiLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(uiLanguage, "title")}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@400;500;600;700&family=LINE+Seed+JP:wght@400;700&display=swap" rel="stylesheet">
    {
      googleCx && (
        <>
          <script is:inline>
            window.__gcse = {
              initializationCallback() {
                window.dispatchEvent(new Event("ods:pse-ready"));
              }
            };
          </script>
          <script async src={`https://cse.google.com/cse.js?cx=${encodeURIComponent(googleCx)}`}></script>
        </>
      )
    }
  </head>
  <body>


    <main class="page">
      <section class="search-panel" aria-labelledby="search-heading">
        <div class="search-header">
          <h1 id="search-heading">
            <span class="lang-en">{t("en", "queryLabel")}</span>
            <span class="lang-ja">{t("ja", "queryLabel")}</span>
          </h1>
          <div class="header-actions">
            <fieldset class="lang-switch">
              <legend class="sr-only">UI Language</legend>
              <label class:list={["lang-btn", { active: uiLanguage === "en" }]}>
                <input type="radio" name="ui" value="en" class="sr-only" checked={uiLanguage === "en"} data-ui-radio>
                EN
              </label>
              <label class:list={["lang-btn", { active: uiLanguage === "ja" }]}>
                <input type="radio" name="ui" value="ja" class="sr-only" checked={uiLanguage === "ja"} data-ui-radio>
                JA
              </label>
            </fieldset>
            <button class="text-button" type="button" data-help-open>
              <span class="lang-en">{t("en", "help")}</span>
              <span class="lang-ja">{t("ja", "help")}</span>
            </button>
          </div>
        </div>
        <form class="search-form" method="get" action="/" data-search-form>
          <input type="hidden" name="ui" value={uiLanguage} data-ui-hidden />
          <div class="query-row">
            <div class="search-group">
              <label class="sr-only" for="q">Search query</label>
              <div class="query-stack" data-query-stack data-known-languages={JSON.stringify(Array.from(knownLanguages))}>
                <div class="query-highlight" aria-hidden="true" data-query-highlight></div>
                <input
                  id="q"
                  name="q"
                  value={q}
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="<language> <search words>"
                  data-query-input
                  autofocus
                />
              </div>
              <button type="submit">
                <span class="lang-en">{t("en", "search")}</span>
                <span class="lang-ja">{t("ja", "search")}</span>
              </button>
            </div>
          </div>

          {
            parsed.languages.length > 0 && (
              <div class="active-tags" data-active-tags>
                {parsed.languages.map((lang) => {
                  const langName = catalog.languages.find((l) => l.id === lang)?.name || lang;
                  return (
                    <span class="fpill">
                      <span class="fpill-label">{langName}</span>
                      <button type="button" class="fpill-x" data-remove-tag={lang} aria-label={`Remove ${langName}`}>×</button>
                    </span>
                  );
                })}
              </div>
            )
          }

          <p class="examples">
            <span class="lang-en">{t("en", "examples")}</span>
            <span class="lang-ja">{t("ja", "examples")}</span>
          </p>

          <div class="controls-row">
            <div class="filters">
              <label class="switch-label">
                <span class="lang-en">{t("en", "includeTrusted")}</span>
                <span class="lang-ja">{t("ja", "includeTrusted")}</span>
                <input
                  type="checkbox"
                  name="sourceMode"
                  value="all"
                  class="pill-toggle"
                  checked={sourceMode === "all"}
                  data-source-toggle
                />
              </label>
            </div>
            
            <div class="filters">
              <span class="filter-label">
                <span class="lang-en">{t("en", "docsLocale")}:</span>
                <span class="lang-ja">{t("ja", "docsLocale")}:</span>
              </span>
              <fieldset class="seg-toggle">
                <legend class="sr-only">Docs Locale</legend>
                <label class:list={["seg-btn", { active: !locale }]}>
                  <input type="radio" name="docsLocale" value="" class="sr-only" checked={!locale} data-docs-radio>
                  <span class="lang-en">All</span>
                  <span class="lang-ja">すべて</span>
                </label>
                <label class:list={["seg-btn", { active: locale === "en" }]}>
                  <input type="radio" name="docsLocale" value="en" class="sr-only" checked={locale === "en"} data-docs-radio>
                  EN
                </label>
                <label class:list={["seg-btn", { active: locale === "ja" }]}>
                  <input type="radio" name="docsLocale" value="ja" class="sr-only" checked={locale === "ja"} data-docs-radio>
                  JA
                </label>
              </fieldset>
            </div>
          </div>

          <details class="source-details">
            <summary>
              <span class="lang-en">{t("en", "sources")}</span>
              <span class="lang-ja">{t("ja", "sources")}</span>
            </summary>
            <div class="source-lists">
              {
                (hasQuery && parsed.languages.length > 0 ? trustedScope.languages : catalog.languages).map((language) => (
                  <div class="language-group">
                    <h3 class="language-name">{language.name}</h3>
                    <div class="source-grid">
                      {
                        language.sources.map((source) => {
                          const isOfficial = source.kind === "official";
                          const disabled = !isOfficial && sourceMode !== "all";
                          return (
                            <label class:list={["source-option", { disabled }]}>
                              <input
                                type="checkbox"
                                name="sourceId"
                                value={source.id}
                                checked={selectedIds.has(source.id)}
                                disabled={disabled}
                                class="pill-toggle"
                              />
                              <span>
                                <strong>{source.name}</strong>
                                <small>
                                  {source.domains[0]} · {sourceLabel(source.kind)}
                                </small>
                              </span>
                            </label>
                          );
                        })
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </details>
        </form>
      </section>

      {
        parsed.errors.length > 0 && (
          <section class="notice error" aria-live="polite">
            {parsed.errors.map((error) => <p>{error.message}</p>)}
          </section>
        )
      }

      {
        scope.localeNotices.length > 0 && (
          <div class="locale-notice muted">
            <small>
              <span class="lang-en">Note: {t("en", "localeUnavailable")}</span>
              <span class="lang-ja">※ {t("ja", "localeUnavailable")}</span>
              ({scope.localeNotices.map((notice) => `${notice.language}: ${notice.sources.map((s) => s.name).join(", ")}`).join("; ")})
            </small>
          </div>
        )
      }

      {
        hasQuery && (
          <section
            class="results"
            aria-live="polite"
            data-pse-results
            data-google-query={pseConfig?.googleQuery ?? ""}
          >
            {
              parsed.errors.length > 0 ? null : !googleCx ? (
                <section class="notice">
                  <p>Set PUBLIC_GOOGLE_PROGRAMMABLE_SEARCH_CX to enable Google Programmable Search results.</p>
                  <p><a href="/search/annotations.xml">annotations.xml</a> and <a href="/search/context.xml">context.xml</a> are generated from the TOML catalog for the Google control panel.</p>
                </section>
              ) : scope.sources.length === 0 ? (
                <p class="muted">
                  <span class="lang-en">{t("en", "noResults")}</span>
                  <span class="lang-ja">{t("ja", "noResults")}</span>
                </p>
              ) : (
                <div
                  class="gcse-searchresults-only"
                  data-gname="docs-results"
                  data-mobileLayout="disabled"
                  data-resultSetSize="web"
                  data-queryParameterName="gq"
                ></div>
              )
            }
          </section>
        )
      }
    </main>

    <dialog class="help-dialog" data-help-dialog>
      <form method="dialog">
        <div class="dialog-header">
          <h2>
            <span class="lang-en">{t("en", "help")}</span>
            <span class="lang-ja">{t("ja", "help")}</span>
          </h2>
          <button class="icon-button" value="close" aria-label="Close">×</button>
        </div>
        <div class="help-content">
          <p><code>&lt;language&gt; &lt;search words&gt;</code></p>
          <p><code>lang:&lt;language&gt; &lt;search words&gt;</code></p>
          <p><code>lang:python,rust &lt;search words&gt;</code></p>
          <p class="muted" style="margin-top: -6px; margin-bottom: 12px; font-size: 0.9em;">
            <span class="lang-en">(File extensions like <code>.py</code> or <code>ts</code> can also be used)</span>
            <span class="lang-ja">(<code>.py</code> や <code>ts</code> などの拡張子も指定できます)</span>
          </p>
          <p><code>&lt;search words&gt; locale:ja</code></p>
          <p><code>&lt;search words&gt; source:all</code></p>
          <p>
            <span class="lang-en">{t("en", "flagsRule")}</span>
            <span class="lang-ja">{t("ja", "flagsRule")}</span>
          </p>
          <p><code>::</code>, <code>?.</code>, <code>$</code>, <code>%</code>, <code>&lt;T&gt;</code> are searched as normal text.</p>
        </div>
      </form>
    </dialog>    <script>
      const input = document.querySelector("[data-query-input]");
      const highlight = document.querySelector("[data-query-highlight]");
      const form = document.querySelector("[data-search-form]");
      const uiHidden = document.querySelector("[data-ui-hidden]");
      const sourceToggle = document.querySelector("[data-source-toggle]");
      const uiRadios = document.querySelectorAll("[data-ui-radio]");
      const docsRadios = document.querySelectorAll("[data-docs-radio]");
      const dialog = document.querySelector("[data-help-dialog]");
      const helpOpen = document.querySelector("[data-help-open]");
      const pseResults = document.querySelector("[data-pse-results]");

      const queryStack = document.querySelector("[data-query-stack]");
      const knownLanguages = new Set(JSON.parse(queryStack?.dataset.knownLanguages || "[]"));

      const flagPattern = /^(lang:[^\s]+|locale:[^\s]+|source:(official|all))$/i;
      const anyFlagPattern = /^(lang:|locale:|source:)/i;

      function normalizeLanguageId(value) {
        const normalized = value.trim().toLowerCase();
        if (normalized === "c++" || normalized === "cplusplus") return "cpp";
        if (normalized === "c#" || normalized === "cs") return "csharp";
        if (normalized === "js" || normalized === "ecmascript") return "javascript";
        if (normalized === "ts") return "typescript";
        if (normalized === "py") return "python";
        if (normalized === "rs") return "rust";
        if (normalized === "rb") return "ruby";
        if (normalized === "golang") return "go";
        return normalized;
      }

      function renderHighlight() {
        if (!input || !highlight) return;
        const tokens = input.value.match(/\S+|\s+/g) || [];
        let seenSearch = false;
        let seenSuffix = false;
        let isFirstToken = true;
        highlight.replaceChildren();
        for (const token of tokens) {
          const span = document.createElement("span");
          span.textContent = token;
          if (/^\s+$/.test(token)) {
            highlight.append(span);
            continue;
          }
          
          const looksFlag = anyFlagPattern.test(token);
          let isFlag = flagPattern.test(token);
          
          if (isFirstToken && !looksFlag && knownLanguages.has(normalizeLanguageId(token))) {
            isFlag = true;
          }

          if (!isFlag && !looksFlag) seenSearch = true;
          if (isFlag && !seenSearch) span.className = "flag-token";
          if (isFlag && seenSearch && !seenSuffix) {
            span.className = "flag-token";
            seenSuffix = true;
          } else if (isFlag && seenSearch && seenSuffix) {
            span.className = "flag-token";
          } else if (looksFlag) {
            span.className = "flag-token invalid";
          }
          highlight.append(span);
          isFirstToken = false;
        }
      }

      function setCookie(name, value) {
        document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=31536000; SameSite=Lax`;
      }

      input?.addEventListener("input", renderHighlight);
      input?.addEventListener("scroll", () => {
        if (highlight) highlight.scrollLeft = input.scrollLeft;
      });

      uiRadios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          setCookie("ods_ui", e.target.value);
          if (uiHidden) uiHidden.value = e.target.value;
          document.documentElement.lang = e.target.value;
          uiRadios.forEach((r) => r.parentElement.classList.remove("active"));
          if (e.target.checked) e.target.parentElement.classList.add("active");
        });
      });
      
      sourceToggle?.addEventListener("change", () => {
        if (sourceToggle.checked) {
          sourceToggle.parentElement.classList.add("active");
        } else {
          sourceToggle.parentElement.classList.remove("active");
        }
        setCookie("ods_source", sourceToggle.checked ? "all" : "official");
        form?.submit();
      });

      docsRadios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          setCookie("ods_docs_locale", e.target.value);
          form?.submit();
        });
      });

      helpOpen?.addEventListener("click", () => dialog?.showModal());

      dialog?.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close();
        }
      });

      // Handle active language tag removal
      const activeTagsContainer = document.querySelector("[data-active-tags]");
      activeTagsContainer?.addEventListener("click", (e) => {
        const removeBtn = e.target.closest("[data-remove-tag]");
        if (!removeBtn || !input) return;
        
        const langToRemove = removeBtn.dataset.removeTag;
        let val = input.value;
        
        // 1. Remove from lang: flags (e.g. lang:python or lang:python,rust)
        const langFlagRegex = new RegExp(`\\blang:([^\\s]+)`, 'i');
        const match = val.match(langFlagRegex);
        if (match) {
          const langs = match[1].split(',');
          const filteredLangs = langs.filter(l => l.toLowerCase() !== langToRemove.toLowerCase());
          if (filteredLangs.length > 0) {
            val = val.replace(match[0], `lang:${filteredLangs.join(',')}`);
          } else {
            val = val.replace(new RegExp(`\\s*lang:${match[1]}\\s*`, 'i'), ' ').trim();
          }
        } else {
          // 2. Remove as leading bare token (e.g. "python map" -> "map")
          const tokens = val.match(/\S+|\s+/g) || [];
          if (tokens.length > 0 && normalizeLanguageId(tokens[0]) === normalizeLanguageId(langToRemove)) {
            tokens.shift();
            if (tokens.length > 0 && /^\s+$/.test(tokens[0])) {
              tokens.shift();
            }
            val = tokens.join('');
          }
        }

        input.value = val;
        renderHighlight();
        form?.submit();
      });

      // Inject the processed query into the "gq" parameter for Google CSE auto-execution
      if (pseResults?.dataset.googleQuery) {
        const url = new URL(window.location.href);
        url.searchParams.set("gq", pseResults.dataset.googleQuery);
        window.history.replaceState({}, "", url.toString());
      }
      


      input?.addEventListener("input", renderHighlight);
      input?.addEventListener("scroll", () => {
        if (highlight) highlight.scrollLeft = input.scrollLeft;
      });
      renderHighlight();
    </script>
  </body>
</html>
