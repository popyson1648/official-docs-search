{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "langref-search",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "official-docs-search.popyson.com",
      "custom_domain": true
    }
  ]
}
